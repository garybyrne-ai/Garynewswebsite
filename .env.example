# Bharat Wire India — environment configuration
# Copy to .env in the project root (next to src/ and public/). Never place it inside public/.

# development | production
APP_ENV=development
APP_NAME="Bharat Wire India"
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

# First administrator (created by scripts/setup.php)
ADMIN_EMAIL=admin@bharatwire.in
ADMIN_PASSWORD=ChangeMe123!

# Demo contributor accounts (scripts/seed.php). Leave blank to generate random passwords.
CONTRIBUTOR_PASSWORD=Contributor-2090

# Sessions
SESSION_DAYS=30
SESSION_COOKIE=me_session

# Optional absolute private directory; default is PROJECT/storage
# STORAGE_PATH=/var/www/bharatwire/storage

# Security — IP/device logging
# Reports, comments, notices, closure submissions and account registration/login record the
# submitter's IP address and browser user-agent (admin/editor eyes only, IT Rules 2021-style
# traceability). Old values are erased automatically by scripts/purge-pii.php after
# pii_retention_days (Newsroom → Settings → Security; default 180). Only trust the
# X-Forwarded-For header (instead of the raw connection IP) when the app genuinely sits behind a
# reverse proxy/load balancer you control — otherwise a client can spoof it.
TRUST_PROXY_HEADERS=false

# Uploads
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=600
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Trust engine
AUTO_PUBLISH_SAFE=false
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# News wire (real Indian sources defined in config/sources.json)
WIRE_ENABLED=true
# Refresh automatically (in the background under PHP-FPM, or via the browser ping) once the wire is older than this
WIRE_AUTO_REFRESH=true
WIRE_REFRESH_MINUTES=20
# Secret for GET /cron/wire?key=... (generated by the installer / setup). Point a cron job or uptime monitor at it.
CRON_KEY=
WIRE_MAX_AGE_DAYS=14
# Wire headlines are kept this long for the Wire+ members' archive before pruning.
WIRE_KEEP_DAYS=365
WIRE_USER_AGENT="BharatWireBot/4.0 (+https://bharatwire.in)"

# Secret for short-lived signed URLs (falls back to CRON_KEY)
APP_KEY=

# Email — the 7am state digest, death-notice and closure alerts, report confirmations.
# MAIL_TRANSPORT: log (development, writes storage/logs/mail.log) | mail (PHP mail(), fine on Cloudways) | smtp
MAIL_TRANSPORT=log
MAIL_FROM=news@yourdomain.in
MAIL_REPLY_TO=editor@yourdomain.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# Stripe — Wire+ membership and Wire Ads subscriptions. Prices are set in Newsroom → Settings and
# sent as inline price data, so only the secret key (and webhook secret) is required.
# STRIPE_PRICE_WIRE_PLUS is optional: set it to bill monthly Wire+ against an existing Stripe Price instead.
# Optional: gateway keys can be entered in the newsroom (Settings → Payment gateways) instead of here.
# Mail and gateway credentials can all be entered in the newsroom instead of here.
# Brevo: set MAIL_TRANSPORT=brevo and BREVO_API_KEY=xkeysib-… , or use SMTP_HOST=smtp-relay.brevo.com
BREVO_API_KEY=
MAIL_FROM_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WIRE_PLUS=

# PayPal — Wire Ads subscriptions (REST app credentials; sandbox until you are ready)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# Razorpay — UPI (BHIM, Google Pay, PhonePe, Paytm and every other UPI app show up automatically
# on Razorpay's own hosted checkout, no separate integration per app), plus cards and netbanking.
# Used for Wire+ membership (UPI AutoPay subscription) and Wire Ads packages (Payment Links).
# Get keys from Razorpay Dashboard → Settings → API Keys; set the webhook secret when you add
# the webhook URL shown in the newsroom under Settings → Payment gateways.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Live local-data widgets (all optional, free keys, entered in the newsroom under
# Settings -> Live data rather than here — they're not payment credentials):
#  - waqi_token         air quality on state pages, free at https://aqicn.org/data-platform/token
#  - agmarknet_api_key  mandi prices on state pages, free at https://data.gov.in/user/register
#  - cricket_api_key    live cricket ticker, free tier at https://cricapi.com
# Each widget stays silently switched off until its key is added.
