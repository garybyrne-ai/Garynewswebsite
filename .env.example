# ME News Ireland — environment configuration
# Copy to .env in the project root (next to src/ and public/). Never place it inside public/.

# development | production
APP_ENV=development
APP_NAME="ME News Ireland"
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Dublin

# First administrator (created by scripts/setup.php)
ADMIN_EMAIL=admin@menews.ie
ADMIN_PASSWORD=ChangeMe123!

# Demo contributor accounts (scripts/seed.php). Leave blank to generate random passwords.
CONTRIBUTOR_PASSWORD=Contributor-2090

# Sessions
SESSION_DAYS=30
SESSION_COOKIE=me_session

# Optional absolute private directory; default is PROJECT/storage
# STORAGE_PATH=/var/www/menews/storage

# Uploads
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=600
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Trust engine
AUTO_PUBLISH_SAFE=false
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# News wire (real Irish sources defined in config/sources.json)
WIRE_ENABLED=true
# Refresh automatically (in the background under PHP-FPM, or via the browser ping) once the wire is older than this
WIRE_AUTO_REFRESH=true
WIRE_REFRESH_MINUTES=20
# Secret for GET /cron/wire?key=... (generated by the installer / setup). Point a cron job or uptime monitor at it.
CRON_KEY=
WIRE_MAX_AGE_DAYS=14
# Wire headlines are kept this long for the ME+ members' archive before pruning.
WIRE_KEEP_DAYS=365
WIRE_USER_AGENT="MENewsWire/4.0 (+https://menews.ie)"

# Secret for short-lived signed URLs (falls back to CRON_KEY)
APP_KEY=

# Email — the 7am county digest, death-notice and closure alerts, report confirmations.
# MAIL_TRANSPORT: log (development, writes storage/logs/mail.log) | mail (PHP mail(), fine on Cloudways) | smtp
MAIL_TRANSPORT=log
MAIL_FROM=news@yourdomain.ie
MAIL_REPLY_TO=editor@yourdomain.ie
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# Stripe — ME+ membership and ME Ads subscriptions. Prices are set in Newsroom → Settings and
# sent as inline price data, so only the secret key (and webhook secret) is required.
# STRIPE_PRICE_ME_PLUS is optional: set it to bill monthly ME+ against an existing Stripe Price instead.
# Optional: gateway keys can be entered in the newsroom (Settings → Payment gateways) instead of here.
# Mail and gateway credentials can all be entered in the newsroom instead of here.
# Brevo: set MAIL_TRANSPORT=brevo and BREVO_API_KEY=xkeysib-… , or use SMTP_HOST=smtp-relay.brevo.com
BREVO_API_KEY=
MAIL_FROM_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ME_PLUS=

# PayPal — ME Ads subscriptions (REST app credentials; sandbox until you are ready)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
