# ME News Ireland — environment configuration
# Copy to .env in the project root (next to src/ and public/). Never place it inside public/.

# development | production
APP_ENV=development
APP_NAME="ME News Ireland"
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TIMEZONE=Europe/Dublin

# First administrator (created by scripts/setup.php)
ADMIN_EMAIL=admin@menews.ie
ADMIN_PASSWORD=ChangeMe123!

# Demo contributor accounts (scripts/seed.php). Leave blank to generate random passwords.
CONTRIBUTOR_PASSWORD=Contributor-2090

# Sessions
SESSION_DAYS=30
SESSION_COOKIE=me_session

# Optional absolute private directory; default is PROJECT/storage
# STORAGE_PATH=/var/www/menews/storage

# Uploads
MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=600
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Trust engine
AUTO_PUBLISH_SAFE=false
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# News wire (real Irish sources defined in config/sources.json)
WIRE_ENABLED=true
WIRE_REFRESH_MINUTES=20
WIRE_MAX_AGE_DAYS=14
WIRE_USER_AGENT="MENewsWire/4.0 (+https://menews.ie)"

# ME+ membership via Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ME_PLUS=
ME_PLUS_PRICE_LABEL=€6.99/month
